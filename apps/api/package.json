{
  "name": "@screenstash/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/index.ts src/server.ts --format esm --platform node --target node22 --sourcemap --clean",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1148.0",
    "@aws-sdk/s3-request-presigner": "3.1148.0",
    "@clerk/express": "2.1.77",
    "@screenstash/db": "workspace:*",
    "@screenstash/shared": "workspace:*",
    "@vercel/functions": "3.9.11",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "sharp": "0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "tsup": "8.5.1",
    "tsx": "4.23.15"
  }
}
